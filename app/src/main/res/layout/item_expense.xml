<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_subtle"
    app:cardBackgroundColor="@color/surface_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="13dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <!-- Icon circle -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp">

            <View
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_category_icon"/>

            <TextView
                android:id="@+id/tvCategoryIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🍔"
                android:textSize="21sp"
                android:gravity="center"/>
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Food"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgeReceipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/surface_overlay"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📎"
                        android:textSize="10sp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgeBillable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="@color/primary_100"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvBillableText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Billable"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/primary_700"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food &amp; Dining"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:visibility="gone"
                android:layout_marginTop="1dp"/>

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today · 2:30 PM"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹500"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/expense_600"
            android:layout_marginStart="12dp"
            android:gravity="end"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>